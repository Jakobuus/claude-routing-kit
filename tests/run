#!/bin/bash
# tests/run — runs every tests/test_*.sh, prints PASS n / FAIL n, exits 1 on any failure.
set -u
cd "$(dirname "$0")"

total_pass=0
total_fail=0
any_fail=0

for f in test_*.sh; do
  [ -f "$f" ] || continue
  out=$(bash "$f" 2>&1)
  code=$?
  echo "$out"
  p=$(echo "$out" | sed -n 's/.*PASS \([0-9][0-9]*\) \/ FAIL \([0-9][0-9]*\).*/\1/p' | tail -1)
  fcount=$(echo "$out" | sed -n 's/.*PASS \([0-9][0-9]*\) \/ FAIL \([0-9][0-9]*\).*/\2/p' | tail -1)
  p=${p:-0}
  fcount=${fcount:-0}
  # A fail() inside a subshell prints but never reaches the file's FAIL_COUNT;
  # count the printed lines too, so such a failure can't hide.
  printed=$(echo "$out" | grep -c '^FAIL:')
  if [ "$printed" -gt "$fcount" ]; then
    echo "  ($f printed $printed FAIL lines but its summary counted $fcount)"
    fcount=$printed
  fi
  total_pass=$((total_pass + p))
  total_fail=$((total_fail + fcount))
  if [ "$code" -ne 0 ]; then
    any_fail=1
  fi
  if [ "$fcount" -gt 0 ]; then
    any_fail=1
  fi
done

echo "PASS $total_pass / FAIL $total_fail"
if [ "$any_fail" -ne 0 ]; then
  exit 1
fi
exit 0
