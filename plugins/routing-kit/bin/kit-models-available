#!/bin/bash
# Local availability only; refresh is explicit.
set -u
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
cache_home="${ROUTING_KIT_HOME:-${KIT_HOME:-$HOME/.config/routing-kit}}"
refresh=false
if [ "${1:-}" = --refresh ]; then refresh=true; shift; fi
[ $# -eq 1 ] || exit 4
case "$1" in
  codex)
    [ "$refresh" = false ] || exit 4
    file="${CODEX_HOME:-$HOME/.codex}/models_cache.json"
    [ -r "$file" ] || exit 4
    result=$(jq -er '[.models[].slug | select(type == "string" and test("^[a-z0-9][a-z0-9.-]{2,60}$"))] | if length > 0 then .[] else error("empty") end' "$file" 2>/dev/null) || exit 4
    printf '%s\n' "$result" ;;
  gemini)
    file="$cache_home/cache/agy-models.txt"
    if [ "$refresh" = true ]; then
      mkdir -p "$cache_home/cache" || exit 4
      tmp=$(mktemp "$cache_home/cache/agy-models.XXXXXX") || exit 4
      trap 'rm -f "$tmp" "$tmp.raw"' EXIT
      if agy models </dev/null > "$tmp.raw" 2>/dev/null; then
        awk '$1 ~ /^[a-z0-9][a-z0-9.-]*$/ && length($1)>=3 && length($1)<=61 {print $1}' "$tmp.raw" > "$tmp"
        [ ! -s "$tmp" ] || mv "$tmp" "$file" || exit 4
      fi
    fi
    [ -r "$file" ] || exit 4
    result=$(awk '$1 ~ /^[a-z0-9][a-z0-9.-]*$/ && length($1)>=3 && length($1)<=61 {print $1}' "$file")
    [ -n "$result" ] || exit 4
    printf '%s\n' "$result" ;;
  *) exit 4 ;;
esac
