#!/bin/bash
# kit-routing-table [--profile FILE] [--models FILE] [--main claude|codex|gemini]
# Prints a markdown routing table built from the friend's profile and
# rules/models.json (the only place model names live).
#
# --main defaults to the profile's main_agent, else claude. With codex or
# gemini the table is written for that company's strong model as the main
# session; Claude then only helps (called as claude -p --model <id>) in the
# Review, Second opinion and lookup rows, because no Claude build script exists.
#
# Fable row, by plan. Source: Anthropic help article "Claude Fable models on
# your plan", https://support.claude.com/en/articles/15424964, read 2026-11-15.
# Fable is inside the plan's limits on Max (5x and 20x) and on premium Team
# seats, and is billed at API rates on the Claude API; on Pro and on standard
# Team seats it runs on pay-as-you-go usage credits only. The profile has no
# seat tier and cannot tell premium seats from standard ones, so the row shows
# for max5, max20 and api only, never for pro or team.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
. "$SCRIPT_DIR/kit-common"
kit_require_supported
# jq is essential here: fail fast (exit 3, install hint) rather than
# letting a `x=$(kit_jq ...)` below mask the real problem. The
# session-start hook already treats any non-zero exit from this script as
# "print a one-line repair message, exit 0" -- it never blocks a session.
kit_require_jq

USAGE="usage: kit-routing-table [--profile FILE] [--models FILE] [--main claude|codex|gemini]"
PROFILE_FILE="$KIT_HOME/profile.json"
MODELS_FILE="$SCRIPT_DIR/../rules/models.json"
MAIN=""

while [ $# -gt 0 ]; do
  case "$1" in
    --profile)
      [ $# -ge 2 ] || kit_die 2 "$USAGE"
      PROFILE_FILE="$2"; shift 2 ;;
    --models)
      [ $# -ge 2 ] || kit_die 2 "$USAGE"
      MODELS_FILE="$2"; shift 2 ;;
    --main)
      [ $# -ge 2 ] || kit_die 2 "$USAGE"
      MAIN="$2"; shift 2 ;;
    *) kit_die 2 "$USAGE" ;;
  esac
done
case "$MAIN" in
  ""|claude|codex|gemini) ;;
  *) kit_die 2 "$USAGE" ;;
esac

if [ ! -f "$PROFILE_FILE" ]; then
  kit_die 2 "no profile at $PROFILE_FILE"
fi

valid=$(kit_jq -e '
  (.version == 1) and
  ((.claude_plan // "") as $c | (.main_agent // "claude") as $m |
    ((["pro","max5","max20","team","api"] | index($c) != null) or ($c == "none" and $m != "claude"))) and
  ((if .codex == null then "none" else .codex end) as $c |
    ($c | type) == "string" and (["none","plus","pro","business","api"] | index($c) != null)) and
  ((if .gemini == null then "none" else .gemini end) as $g |
    ($g | type) == "string" and (["none","pro","ultra"] | index($g) != null)) and
  ((.jules // false) | type == "boolean") and
  ((.kimi // false) | type == "boolean") and
  ((.glm // false) | type == "boolean") and
  ((.paseo // false) | type == "boolean") and
  ((.main_agent // "claude") as $m | ["claude","codex","gemini"] | index($m) != null)
' "$PROFILE_FILE" >/dev/null 2>&1; echo $?)
if [ "$valid" != "0" ]; then
  kit_die 2 "invalid profile at $PROFILE_FILE"
fi

gemini=$(kit_jq -r '.gemini // "none"' "$PROFILE_FILE")
codex=$(kit_jq -r '.codex // "none"' "$PROFILE_FILE")
jules=$(kit_jq -r '.jules // false' "$PROFILE_FILE")
kimi=$(kit_jq -r '.kimi // false' "$PROFILE_FILE")
glm=$(kit_jq -r '.glm // false' "$PROFILE_FILE")
claude_plan=$(kit_jq -r '.claude_plan' "$PROFILE_FILE")
[ -n "$MAIN" ] || MAIN=$(kit_jq -r '.main_agent // "claude"' "$PROFILE_FILE")
have_claude="yes"
if [ "$claude_plan" = none ]; then have_claude="no"; fi
case "$MAIN" in
  codex) [ "$codex" != none ] || kit_die 2 "main agent codex needs a Codex plan in the profile" ;;
  gemini) [ "$gemini" != none ] || kit_die 2 "main agent gemini needs a Gemini plan in the profile" ;;
  claude) [ "$have_claude" = yes ] || kit_die 2 "main agent claude needs a Claude plan in the profile" ;;
esac

if [ ! -r "$MODELS_FILE" ]; then
  kit_die 2 "cannot read models file at $MODELS_FILE"
fi

# jq -e treats a null/false result as failure, so a missing field or an
# unreadable/malformed models file is caught here instead of silently
# producing an empty model name.
read_model() {
  kit_jq -e -r "$1" "$MODELS_FILE" 2>/dev/null
}


fail_models() { kit_die 2 "invalid or incomplete models file at $MODELS_FILE"; }
# Everything from models.json that is rendered into the session output is
# checked first, whatever the local CLIs offer and whichever lanes are in use: a
# model id must look like a model id and an effort value must be a known level,
# so a bad file cannot put text of its own into every session. (\z, not $, so a
# trailing newline does not slip through.)
kit_jq -e '
  def id: type == "string" and test("^[a-z0-9][a-z0-9.-]{2,60}\\z");
  def eff: type == "string" and IN("low","medium","high","xhigh","max");
  ([.claude, .codex, .gemini] | all(.[]; type == "object" and all(.[]; id)))
  and ((.fallbacks // {}) | type == "object" and all(to_entries[]; (.key | id) and (.value | id)))
  and ((.effort // {}) | type == "object" and all(to_entries[]; (.key | id) and (.value | type == "object") and all(.value[]; eff)))
' "$MODELS_FILE" >/dev/null 2>&1 || fail_models
claude_top=$(read_model '.claude.top') || fail_models
claude_strong=$(read_model '.claude.strong') || fail_models
claude_build=$(read_model '.claude.build') || fail_models
claude_lookup=$(read_model '.claude.lookup') || fail_models
codex_strong=$(read_model '.codex.strong') || fail_models
codex_review=$(read_model '.codex.review') || fail_models
codex_build=$(read_model '.codex.build') || fail_models
codex_screens=$(read_model '.codex.screens') || fail_models
codex_lookup=$(read_model '.codex.lookup') || fail_models
if [ "$gemini" != none ]; then
  gemini_strong=$(read_model '.gemini.strong') || fail_models
  gemini_build=$(read_model '.gemini.build') || fail_models
  gemini_long=$(read_model '.gemini.long_read') || fail_models
  gemini_mid=$(read_model '.gemini.mid') || fail_models
  gemini_lookup=$(read_model '.gemini.lookup') || fail_models
  gemini_research=$(read_model '.gemini.research') || fail_models
fi
have_codex="no"
[ "$codex" != "none" ] && have_codex="yes"
have_gemini="no"
[ "$gemini" != none ] && have_gemini="yes"

# --- what the local CLIs offer ----------------------------------------------
# kit-models-available prints one model ID per line and exits 0 when it knows
# the list; any other exit means unknown, and unknown never triggers a fallback.
AV_claude=""; AV_claude_rc=4
AV_codex=""; AV_codex_rc=4
AV_gemini=""; AV_gemini_rc=4
if [ -x "$SCRIPT_DIR/kit-models-available" ]; then
  AV_claude=$("$SCRIPT_DIR/kit-models-available" claude 2>/dev/null); AV_claude_rc=$?
  if [ "$have_codex" = yes ]; then
    AV_codex=$("$SCRIPT_DIR/kit-models-available" codex 2>/dev/null); AV_codex_rc=$?
  fi
  if [ "$have_gemini" = yes ]; then
    AV_gemini=$("$SCRIPT_DIR/kit-models-available" gemini 2>/dev/null); AV_gemini_rc=$?
  fi
fi

NOTES=""
RESOLVED=""
has_line() { printf '%s\n' "$1" | grep -qxF -- "$2"; }
add_line_note() {
  case "
$NOTES
" in
    *"
$1
"*) ;;
    *) NOTES="${NOTES:+$NOTES
}$1" ;;
  esac
}
# resolve LANE MODEL: sets RESOLVED to the model to use, the fallback when the
# local CLI lacks MODEL, or "" when neither is offered (the choice drops out).
resolve() {
  lane="$1"; model="$2"
  RESOLVED="$model"
  case "$lane" in
    claude) rc=$AV_claude_rc; list=$AV_claude ;;
    codex) rc=$AV_codex_rc; list=$AV_codex ;;
    gemini) rc=$AV_gemini_rc; list=$AV_gemini ;;
    *) return 0 ;;
  esac
  [ "$rc" = 0 ] || return 0
  has_line "$list" "$model" && return 0
  fb=$(kit_jq -r --arg m "$model" '.fallbacks[$m] // empty' "$MODELS_FILE" 2>/dev/null)
  if [ -n "$fb" ] && has_line "$list" "$fb"; then
    RESOLVED="$fb"
    add_line_note "Note: $model is not offered by your $lane CLI; using $fb. Check for a kit update."
  else
    RESOLVED=""
    add_line_note "Note: $model is not offered by your $lane CLI and has no usable fallback; leaving it out. Check for a kit update."
  fi
}

c_top=""; c_strong=""; c_build=""; c_lookup=""
if [ "$have_claude" = yes ]; then
  case "$claude_plan" in
    max5|max20|api) resolve claude "$claude_top"; c_top="$RESOLVED" ;;
  esac
  resolve claude "$claude_strong"; c_strong="$RESOLVED"
  resolve claude "$claude_build"; c_build="$RESOLVED"
  resolve claude "$claude_lookup"; c_lookup="$RESOLVED"
fi
x_strong=""; x_review=""; x_build=""; x_screens=""; x_lookup=""
if [ "$have_codex" = yes ]; then
  resolve codex "$codex_strong"; x_strong="$RESOLVED"
  resolve codex "$codex_review"; x_review="$RESOLVED"
  resolve codex "$codex_build"; x_build="$RESOLVED"
  resolve codex "$codex_screens"; x_screens="$RESOLVED"
  resolve codex "$codex_lookup"; x_lookup="$RESOLVED"
fi
g_build=""; g_long=""; g_mid=""; g_lookup=""; g_research=""
if [ "$have_gemini" = yes ]; then
  resolve gemini "$gemini_build"; g_build="$RESOLVED"
  resolve gemini "$gemini_long"; g_long="$RESOLVED"
  resolve gemini "$gemini_mid"; g_mid="$RESOLVED"
  resolve gemini "$gemini_lookup"; g_lookup="$RESOLVED"
  resolve gemini "$gemini_research"; g_research="$RESOLVED"
fi

# --- effort text, built from models.json "effort" ---------------------------
effort_of() { kit_jq -r --arg m "$1" --arg k "$2" '.effort[$m][$k] // empty' "$MODELS_FILE" 2>/dev/null; }
# "high, never max" / "medium or high, never above"
eff_range() {
  u=$(effort_of "$1" use); m=$(effort_of "$1" max)
  [ -n "$u" ] || return 0
  if [ -z "$m" ] || [ "$m" = "$u" ]; then echo "$u, never max"; else echo "$u or $m, never above"; fi
}
# "medium, high for checks"
eff_checks() {
  u=$(effort_of "$1" use); m=$(effort_of "$1" max)
  [ -n "$u" ] || return 0
  if [ -z "$m" ] || [ "$m" = "$u" ]; then echo "$u"; else echo "$u, $m for checks"; fi
}
# "at high, never low"
eff_min() {
  n=$(effort_of "$1" min)
  [ -n "$n" ] || return 0
  echo "at $n, never low"
}

# --- row helpers ------------------------------------------------------------
LIST=""; NOTE=""
list_reset() { LIST=""; NOTE=""; }
add_item() { [ -n "$1" ] && LIST="${LIST:+$LIST · }$1"; return 0; }
add_note() { [ -n "$1" ] && NOTE="${NOTE:+$NOTE; }$1"; return 0; }
TRIAL_MODELS=$(kit_jq -r '.trials // {} | keys[]' "$MODELS_FILE")
row() { # work use notes
  use_text="$2"
  for trial_model in $TRIAL_MODELS; do
    [ "$trial_model" != jules ] || trial_model=Jules
    use_text=${use_text//"$trial_model"/"$trial_model (trial)"}
  done
  use_text=${use_text//" (trial) (the main session)"/" (the main session) (trial)"}
  if [ -n "$3" ]; then echo "| $1 | $use_text | $3 |"; else echo "| $1 | $use_text | |"; fi
}

echo "| Work | Use | Notes |"
echo "|---|---|---|"

if [ "$MAIN" = claude ]; then
# 1. Plans, architecture, judgment
list_reset
use="Claude $c_strong"
[ -z "$c_top" ] || use="$use (or Fable/Opus main session)"
add_note "$(eff_checks "$c_strong")"
if [ -n "$x_strong" ]; then
  add_note "big plans: ask Codex $x_strong"
else
  add_note "strong models plan and review, never code"
fi
row "Plans, architecture, judgment" "$use" "$NOTE"

# 2. Hardest builds (Fable, by plan)
if [ -n "$c_top" ]; then
  list_reset
  add_note "$(eff_range "$c_top")"
  if [ "$claude_plan" = api ]; then
    add_note "billed per use at API rates (pay per use)"
  else
    add_note "needs room in Fable's share and the Claude week"
  fi
  row "Hardest builds: long overnight runs, or after a cheaper build failed twice" "Claude $c_top" "$NOTE"
fi

# 3. Features, fixes, tests
list_reset
[ -z "$x_build" ] || add_item "Codex $x_build"
add_item "Claude $c_build"
[ -z "$g_build" ] || add_item "Gemini $g_build"
add_note "$c_build: $(eff_range "$c_build")"
[ "$have_codex" = yes ] || [ "$have_gemini" = yes ] && add_note "pick by quota"
[ -z "$g_build" ] || add_note "Argon's weekly pool is small on Pro"
row "Features, bug fixes, tests" "$LIST" "$NOTE"

# 4. Review: a different company than the builder
if [ -n "$x_review" ]; then
  review="Claude work → Codex $x_review"
  [ -z "$x_strong" ] || review="$review, risky changes → $x_strong"
elif [ -n "$x_strong" ]; then
  review="Claude work → Codex $x_strong"
else
  review="fresh Claude $c_strong subagent"
fi
others=""
[ "$have_codex" = yes ] && others="Codex"
if [ "$have_gemini" = yes ]; then
  others="${others:+$others or }Gemini"
fi
[ -z "$others" ] || review="$review; $others work → Claude $c_strong"
if [ -n "$others" ]; then
  review_note="the reviewer reads the diff itself, never the builder's report"
else
  review_note="no other lane to cross-check against"
fi
row "Review" "$review" "$review_note"

# 5. Second opinion
if [ -n "$x_strong" ]; then
  second="Codex $x_strong"
  if [ -n "$c_top" ]; then
    second="$second; big calls add Claude $c_top"
  else
    second="$second; big calls add a fresh Claude $c_strong subagent"
  fi
else
  second="fresh Claude $c_strong subagent"
fi
row "Second opinion" "$second" "via ask-advisers"

# 6-7. Long reads and long outputs (Gemini)
if [ -n "$g_long" ]; then
  row "Whole-repo reads, 300K+ tokens of context" "Gemini $g_long" "read-only; another company's model checks what it claims about the code"
  row "Very long single outputs" "Gemini $g_long" ""
fi

# 8. Screenshots, UI checks, prose from supplied material (Codex Terra)
if [ -n "$x_screens" ]; then
  row "Screenshots, UI checks, prose from supplied material" "Codex $x_screens" "trial: log 5; drop if 2 need fixes"
fi

# 9. UI building
row "UI building" "Claude $c_strong" ""

# 10. Read-only lookups
list_reset
add_item "Claude $c_lookup"
[ -z "$x_lookup" ] || add_item "Codex $x_lookup"
[ -z "$g_lookup" ] || add_item "Gemini $g_lookup"
add_note "$c_lookup prompts under 100K tokens"
[ -z "$x_lookup" ] || add_note "Codex $x_lookup $(eff_min "$x_lookup")"
row "Read-only lookups" "$LIST" "$NOTE"

# 11. Bulk mechanical edits
list_reset
[ -z "$x_lookup" ] || add_item "Codex $x_lookup (or a script it writes, run here)"
[ -z "$g_mid" ] || add_item "Gemini $g_mid"
add_item "Claude $c_build"
[ -z "$x_lookup" ] || add_note "Codex $x_lookup $(eff_min "$x_lookup")"
add_note "only where a script or test checks the result"
row "Bulk mechanical edits" "$LIST" "$NOTE"

# 12. Web research
list_reset
[ -z "$x_build" ] || add_item "Codex $x_build with -c web_search=\"live\""
[ -z "$g_research" ] || add_item "Gemini $g_research"
add_item "Claude $c_build"
row "Web research" "$LIST" ""

# 13. Untrusted input while holding tools that can act
row "Reading untrusted web pages or email while holding tools that can act" "Claude $c_strong" "never Fable"

else
# --- Codex or Gemini as the main session ------------------------------------
# Claude, when the user has it, only helps: it is called as
# `claude -p --model <id>` in the Review, Second opinion and lookup rows. No
# Claude build script exists yet, so Claude never builds from here.
g_strong=""
if [ "$have_gemini" = yes ]; then
  resolve gemini "$gemini_strong"; g_strong="$RESOLVED"
fi
if [ "$MAIN" = codex ]; then
  m_label="Codex"; m_strong="${x_strong:-${x_review:-$x_build}}"
else
  m_label="Gemini"; m_strong="${g_strong:-$g_build}"
fi
m_session="fresh $m_label${m_strong:+ $m_strong} session"
claude_helper=""
[ "$have_claude" = yes ] && claude_helper="Claude $c_strong"
codex_rev=""
if [ -n "$x_review" ]; then
  codex_rev="Codex $x_review"
  [ -z "$x_strong" ] || codex_rev="$codex_rev, risky changes → $x_strong"
elif [ -n "$x_strong" ]; then
  codex_rev="Codex $x_strong"
fi
gemini_rev=""
[ -z "$g_strong" ] || gemini_rev="Gemini $g_strong"
join_parts() { out=""; for part in "$@"; do [ -n "$part" ] && out="${out:+$out; }$part"; done; printf '%s' "$out"; }

# 1. Plans, architecture, judgment
list_reset
use="$m_label${m_strong:+ $m_strong} (the main session)"
add_note "$(eff_checks "$m_strong")"
add_note "strong models plan and review, never code"
row "Plans, architecture, judgment" "$use" "$NOTE"

# 2. Features, fixes, tests
list_reset
[ -z "$x_build" ] || add_item "Codex $x_build"
[ -z "$g_build" ] || add_item "Gemini $g_build"
[ -n "$LIST" ] || add_item "$m_label $m_strong"
[ -z "$x_build" ] || [ -z "$g_build" ] || add_note "pick by quota"
[ -z "$g_build" ] || add_note "Argon's weekly pool is small on Pro"
[ "$have_claude" = no ] || add_note "no Claude build script exists yet, so Claude does not build"
row "Features, bug fixes, tests" "$LIST" "$NOTE"

# 3. Review: a different company than the builder
r_codex=""; r_gemini=""
if [ "$have_codex" = yes ]; then
  if [ -n "$claude_helper" ]; then r_codex="Codex work → $claude_helper"
  elif [ -n "$gemini_rev" ]; then r_codex="Codex work → $gemini_rev"; fi
fi
if [ "$have_gemini" = yes ]; then
  if [ -n "$codex_rev" ]; then r_gemini="Gemini work → $codex_rev"
  elif [ -n "$claude_helper" ]; then r_gemini="Gemini work → $claude_helper"; fi
fi
review=$(join_parts "$r_codex" "$r_gemini")
if [ -n "$review" ]; then
  review_note="the reviewer reads the diff itself, never the builder's report"
  [ -z "$claude_helper" ] || review_note="$review_note; Claude runs as claude -p --model $c_strong"
else
  review="$m_session"
  review_note="no other lane to cross-check against"
fi
row "Review" "$review" "$review_note"

# 4. Second opinion: a different company than the main session
others=""; second=""; big=""
if [ "$MAIN" = codex ]; then
  [ -z "$claude_helper" ] || { others="$claude_helper"; }
  [ -z "$gemini_rev" ] || others="${others:+$others
}$gemini_rev"
else
  [ -z "$x_strong" ] || others="Codex $x_strong"
  [ -z "$claude_helper" ] || others="${others:+$others
}$claude_helper"
fi
second=$(printf '%s\n' "$others" | sed -n '1p')
big=$(printf '%s\n' "$others" | sed -n '2p')
if [ -z "$big" ] && [ -n "$c_top" ]; then big="Claude $c_top"; fi
if [ -n "$second" ]; then
  [ -z "$big" ] || second="$second; big calls add $big"
  so_note="follow the Advisers rules"
  [ -z "$claude_helper" ] || so_note="$so_note; Claude runs as claude -p --model $c_strong"
else
  second="$m_session"
  so_note="follow the Advisers rules; no other lane to ask"
fi
row "Second opinion" "$second" "$so_note"

# 5-6. Long reads and long outputs (Gemini)
if [ -n "$g_long" ]; then
  row "Whole-repo reads, 300K+ tokens of context" "Gemini $g_long" "read-only; another company's model checks what it claims about the code"
  row "Very long single outputs" "Gemini $g_long" ""
fi

# 7. Screenshots, UI checks, prose from supplied material (Codex Terra)
if [ -n "$x_screens" ]; then
  row "Screenshots, UI checks, prose from supplied material" "Codex $x_screens" "trial: log 5; drop if 2 need fixes"
fi

# 8. UI building
list_reset
if [ -n "$x_build" ]; then add_item "Codex $x_build"
elif [ -n "$g_build" ]; then add_item "Gemini $g_build"
else add_item "$m_label $m_strong"; fi
row "UI building" "$LIST" ""

# 9. Read-only lookups
list_reset
[ -z "$x_lookup" ] || add_item "Codex $x_lookup"
[ -z "$g_lookup" ] || add_item "Gemini $g_lookup"
[ "$have_claude" = no ] || add_item "Claude $c_lookup"
[ -n "$LIST" ] || add_item "$m_label $m_strong"
[ "$have_claude" = no ] || add_note "$c_lookup prompts under 100K tokens; run as claude -p --model $c_lookup"
[ -z "$x_lookup" ] || add_note "Codex $x_lookup $(eff_min "$x_lookup")"
row "Read-only lookups" "$LIST" "$NOTE"

# 10. Bulk mechanical edits
list_reset
[ -z "$x_lookup" ] || add_item "Codex $x_lookup (or a script it writes, run here)"
[ -z "$g_mid" ] || add_item "Gemini $g_mid"
[ -n "$LIST" ] || add_item "$m_label $m_strong"
[ -z "$x_lookup" ] || add_note "Codex $x_lookup $(eff_min "$x_lookup")"
add_note "only where a script or test checks the result"
row "Bulk mechanical edits" "$LIST" "$NOTE"

# 11. Web research
list_reset
[ -z "$x_build" ] || add_item "Codex $x_build with -c web_search=\"live\""
[ -z "$g_research" ] || add_item "Gemini $g_research"
[ -n "$LIST" ] || add_item "$m_label $m_strong"
row "Web research" "$LIST" ""

# 12. Untrusted input while holding tools that can act
if [ "$MAIN" = codex ]; then untrusted="Codex ${x_build:-$m_strong}"; else untrusted="Gemini ${g_mid:-${g_build:-$m_strong}}"; fi
row "Reading untrusted web pages or email while holding tools that can act" "$untrusted" "never the top model"
fi

# 14. Mechanical work with an existing check (Jules)
if [ "$jules" = "true" ]; then
  row "Mechanical work with an existing check" "Jules via kit-jules-build" "GitHub repos only; Google shuts Jules down on 31 Dec 2026; move to Gemini"
fi

# Cheap extra builds (Kimi/GLM) -- macOS-only (the Seatbelt jail): never
# listed off a Mac, even if a hand-edited profile.json says kimi/glm true
# (kit-profile itself already refuses to set either true off-Mac).
if [ "$(uname)" = Darwin ] && { [ "$kimi" = "true" ] || [ "$glm" = "true" ]; }; then
  use=""
  if [ "$kimi" = "true" ]; then
    use="locked-build --provider kimi"
  fi
  if [ "$glm" = "true" ]; then
    if [ -n "$use" ]; then
      use="$use · locked-build --provider glm"
    else
      use="locked-build --provider glm"
    fi
  fi
  echo "| Cheap extra builds | $use | committed code only; never paste private data; never start them as Paseo agents |"
fi

if [ -n "$NOTES" ]; then
  echo
  printf '%s\n' "$NOTES"
fi
