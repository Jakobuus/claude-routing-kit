#!/bin/bash
# kit-codex-build --repo DIR --name NAME --brief FILE [--model MODEL]
#
# Runs one Codex build job against a throwaway clone of REPO's HEAD:
#   run_export -> codex exec -m MODEL --dangerously-bypass-approvals-and-sandbox -C wt < brief
#   -> print the diff and run dir -> ledger_append codex
#
# The repo copy leaves the run dir when the run ends, on every exit path. It is DELETED when its work
# is saved: build.patch is saved and applies to the base commit (or the run is a checked "no
# changes"), nothing in the copy is outside the patch (an ignored file, a file written after the
# patch), and no agent is still open in it. Otherwise it is moved whole to
# $KIT_HOME/retained/<run dir name> with the reason (list and delete those with kit-retained).
# The result is <run dir>/build.patch (apply it with `git apply`);
# ROUTING_KIT_KEEP_RUNS=1 keeps the copy in place for debugging.
# A copy holding a nested git repo, a FIFO or a hard-linked file is refused (exit 4).
#
# Transport: profile key "codex_build_transport" ("paseo" or "direct"; default direct) picks the
# default; --paseo / --no-paseo override it. The profile key "paseo" is the Paseo usage-pill flag
# and does not change builds.
# Usage also accepts [--paseo|--no-paseo] [--timeout SECS >= 1 (Paseo only)].
# Pending Paseo runs keep their copy until cleanup can safely finish.
# A finished Paseo run has its copy deleted (or moved to retained, as above) and its workspace and
# agent archived, but only after build.patch is saved and checked against the base commit; otherwise
# the copy stays ("pending").
# Neither is archived while other open agents (child agents, agents in the same folder) would go too.
# The copy and the workspace go only when the single workspace on the copy is the one recorded at
# the start, inside $KIT_HOME/runs (KIT_CODEX_WORKTREES_ROOT overrides that root).
# The line before the last says what was archived; a later run retries what is still pending.
# The checked build is also kept as branch kit-codex/<run dir name> in REPO (one commit on the base
# commit; nothing is checked out), and the manifest names it.
# KIT_CODEX_KEEP_WORKTREE=1 keeps the copy and the agent; the last line then ends with
# worktree=<path>, as it does whenever the copy stays.
# A copy whose git metadata the agent rewrote (.git made a link or a gitfile, a commondir, gitdir
# or config.worktree file added) is kept with its patch and not archived: "git metadata changed".
# Each run first finishes earlier pending runs and archives stopped agents of finished earlier runs
# (only agents its own manifests name, with the recorded cwd); runs under a temp dir are left alone.
# Exit: 0 success, 2 bad input, 3 missing provider, 4 provider/cleanup error,
# 5 secret scan refused, 6 waiting on permission (agent and copy kept), 124 timeout.
# Every exit after the run dir exists ends with `kit-codex-build: exit=N patch=PATH result=PATH`
# (patch= is empty when there is none).
set -uo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd -P)"
. "$BIN_DIR/kit-common"
kit_require_supported
# Fail fast (exit 3, install hint) if jq/python3 are missing, before any
# `x=$(kit_jq ...)` below that could otherwise mask the real problem behind
# a generic "invalid models file" or a false secret-scan refusal.
kit_require_jq
kit_require_python3
. "$BIN_DIR/../lib/export.sh"
. "$BIN_DIR/../lib/ledger.sh"
. "$BIN_DIR/../lib/secret-scan.sh"

MODELS_FILE="$BIN_DIR/../rules/models.json"
REPO="" NAME="" BRIEF="" MODEL=""
PASEO=0
TIMEOUT=1800
TIMEOUT_SET=0
if [ -f "$KIT_HOME/profile.json" ]; then
  if profile_transport=$(kit_jq -r '.codex_build_transport // "direct"' "$KIT_HOME/profile.json" 2>/dev/null); then
    [ "$profile_transport" != paseo ] || PASEO=1
  else
    echo 'kit-codex-build: warning: cannot read profile; using direct transport unless overridden' >&2
  fi
fi
usage() { kit_die 2 "usage: kit-codex-build --repo DIR --name NAME --brief FILE [--model MODEL] [--paseo|--no-paseo] [--timeout SECS]"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      echo "usage: kit-codex-build --repo DIR --name NAME --brief FILE [--model MODEL] [--paseo|--no-paseo] [--timeout SECS]"
      echo "transport: direct Codex by default; Paseo when the profile key codex_build_transport is \"paseo\""
      echo "           (kit-profile set codex_build_transport paseo|direct). --paseo / --no-paseo override it."
      echo "           The profile key \"paseo\" is the Paseo usage-pill flag and does not change builds."
      exit 0 ;;
    --paseo) PASEO=1; shift ;;
    --no-paseo) PASEO=0; shift ;;
    --timeout)
      [ $# -ge 2 ] || usage
      case "$2" in ""|*[!0-9]*) usage ;; esac
      [ "$2" -ge 1 ] 2>/dev/null || usage
      TIMEOUT=$2; TIMEOUT_SET=1; shift 2 ;;
    --repo)
      [ $# -ge 2 ] || usage
      REPO=$2; shift 2 ;;
    --name)
      [ $# -ge 2 ] || usage
      NAME=$2; shift 2 ;;
    --brief)
      [ $# -ge 2 ] || usage
      BRIEF=$2; shift 2 ;;
    --model)
      [ $# -ge 2 ] || usage
      MODEL=$2; shift 2 ;;
    *) usage ;;
  esac
done

[ "$TIMEOUT_SET" = 0 ] || [ "$PASEO" = 1 ] || usage

# KIT_CODEX_CONTINUES: how many times a build that stopped early is told to go on (default 3; 0 = off).
KIT_CODEX_CONTINUES_N=${KIT_CODEX_CONTINUES:-3}
case "$KIT_CODEX_CONTINUES_N" in ""|*[!0-9]*) kit_die 2 "KIT_CODEX_CONTINUES must be a whole number (0 = off)" ;; esac
# codex_continue_check BRIEF FINAL_MESSAGE: 0 (reason on stdout) when the work is clearly not finished.
codex_continue_check() {
  [ "$KIT_CODEX_CONTINUES_N" -gt 0 ] || return 1
  python3 "$BIN_DIR/../lib/codex_continue.py" check "$1" "$2"
}
codex_continue_message() { python3 "$BIN_DIR/../lib/codex_continue.py" message; }

[ -n "$REPO" ] && [ -n "$NAME" ] && [ -n "$BRIEF" ] || usage

# A tab, newline or carriage return in --name/--model would forge extra
# ledger rows or columns downstream. lib/ledger.sh has its own guard; this
# is the first line of defense, rejecting it at the CLI before anything
# else runs.
case "$NAME" in
  *$'\t'*|*$'\n'*|*$'\r'*) kit_die 2 "--name may not contain a tab, newline, or carriage return" ;;
esac
case "$MODEL" in
  *$'\t'*|*$'\n'*|*$'\r'*) kit_die 2 "--model may not contain a tab, newline, or carriage return" ;;
esac

[ -f "$BRIEF" ] || kit_die 2 "no such brief file: $BRIEF"

# From here on, every exit writes exactly one ledger line -- success or
# any failure -- through this single trap, so no exit path (a preflight
# kit_die, a secret-scan refusal, a provider error) can skip it. The
# ledger_append call runs in a subshell: ledger_append itself calls
# kit_die (i.e. exit) if it can't create $KIT_HOME, and without the
# subshell that exit would overwrite the status this trap is supposed to
# be preserving. A warning goes to stderr instead; the original exit code
# always wins. The repo copy is cleared here too: deleted when its work is saved, moved to
# $KIT_HOME/retained otherwise (run_cleanup_own never fails and
# only touches the run dir's wt/home/cfg/tmp); run_dir is still empty on
# exits before run_export, and it does nothing for an empty path.
codex_pid=""
on_exit() {
  code=$?
  # If the script is cut short (SIGTERM/SIGINT, or a kit_die) while codex is
  # still running, stop codex and everything it started BEFORE the repo copy
  # goes: TERM the whole process group, a short grace period, then KILL.
  if [ -n "$codex_pid" ]; then
    {
      kill -TERM -"$codex_pid" 2>/dev/null || kill "$codex_pid" 2>/dev/null
      sleep 0.3
      kill -KILL -"$codex_pid" 2>/dev/null || kill -KILL "$codex_pid" 2>/dev/null
      wait "$codex_pid"
    } 2>/dev/null
  fi
  [ -z "${paseo_head_copy:-}" ] || rm -rf "$paseo_head_copy" 2>/dev/null
  if [ -n "${paseo_started:-}" ]; then
    # A Paseo run with an agent: codex_paseo_finalize deletes (or retains) the repo copy and archives the
    # workspace and the agent only after build.patch is saved and checked and the ownership checks
    # pass. A kept run, a permission wait and a start that went wrong are left as they are.
    if [ "${KIT_CODEX_KEEP_WORKTREE:-}" = 1 ]; then
      paseo_cleanup=kept
    elif [ "${paseo_pending:-false}" = true ]; then
      paseo_cleanup=pending
    else
      codex_paseo_finalize || { [ "$code" -ne 0 ] || code=4; }
    fi
  elif [ -n "${run_dir:-}" ]; then
    # Deletes the copy when its work is saved (lib/export.sh); moves it to $KIT_HOME/retained otherwise.
    # (c) for a direct run: no process may still be in the copy (a child that left Codex's group).
    if [ -d "$run_dir/wt" ] && open_why=$(run_copy_busy "$run_dir"); then :; else open_why=""; fi
    run_cleanup_own "$run_dir" "kit-codex-build ended (exit $code)" "$REPO" "$BASE" "$open_why" || true
    if [ "$code" -ne 0 ] && [ -s "$run_dir/retained-at" ]; then
      echo "kit-codex-build: repo copy retained: $(cat "$run_dir/retained-at")" >&2
    fi
  fi
  ( ledger_append codex "${MODEL:--}" "$NAME" - - "$code" ) \
    || echo "kit-codex-build: warning: could not write a ledger line" >&2
  if [ -z "${paseo_started:-}" ] && [ -n "${run_dir:-}" ] && [ -d "$run_dir" ]; then
    # Direct mode: the same last line as Paseo, on every exit once a run exists.
    direct_patch=""
    [ ! -f "$run_dir/build.patch" ] || direct_patch=$run_dir/build.patch
    if [ "$code" -eq 0 ]; then
      if [ -s "$run_dir/build.patch" ]; then
        echo "next: git apply --index $run_dir/build.patch, run the checks, have the diff reviewed, commit"
      else
        echo "next: no changes were made; read $run_dir/result.md"
      fi
    fi
    echo "kit-codex-build: exit=$code patch=$direct_patch result=$run_dir/codex-output.txt"
  fi
  if [ -n "${paseo_started:-}" ]; then
    [ -f "$run_dir/result.md" ] || echo "(no final message from Codex; exit $code)" > "$run_dir/result.md"
    paseo_patch=""
    [ ! -f "$run_dir/build.patch" ] || paseo_patch=$run_dir/build.patch
    codex_paseo_manifest "$code"
    # A copy that stays is named on the last line too, after the patch and the result.
    paseo_kept=""
    if [ -e "$run_dir/wt" ]; then
      if [ "${KIT_CODEX_KEEP_WORKTREE:-}" = 1 ]; then
        paseo_kept=" worktree=$run_dir/wt (worktree kept: KIT_CODEX_KEEP_WORKTREE=1)"
      else
        paseo_kept=" worktree=$run_dir/wt (worktree kept: ${paseo_kept_why:-cleanup ${paseo_cleanup:-pending}})"
      fi
    fi
    echo "kit-codex-build: exit=$code patch=$paseo_patch result=$run_dir/result.md$paseo_kept"
  fi
  exit "$code"
}
trap on_exit EXIT

if [ -z "$MODEL" ]; then
  MODEL=$(kit_jq -e -r '.codex.build' "$MODELS_FILE" 2>/dev/null) \
    || kit_die 2 "invalid or incomplete models file at $MODELS_FILE"
fi

if [ "$PASEO" = 1 ]; then
  . "$BIN_DIR/../lib/codex-paseo-build.sh"
  trap 'exit 130' INT
  trap 'exit 143' TERM
  codex_paseo_build
  exit $?
fi

command -v codex >/dev/null 2>&1 \
  || kit_die 3 "no codex on PATH: install the Codex CLI and run codex login"

# run_export exits 2 itself on a dirty repo, no HEAD, or a non-repo path.
BASE=$(kit_git -C "$REPO" rev-parse HEAD 2>/dev/null) || kit_die 2 'no HEAD: commit first'
run_dir=$(run_export "$REPO" "$NAME") || exit $?
if [ "$(kit_git -C "$run_dir/wt" rev-parse HEAD)" != "$BASE" ]; then
  rm -rf "$run_dir"
  run_dir=""
  kit_die 2 'the repo changed while the build was starting; run it again'
fi
wt="$run_dir/wt"
run_claim "$run_dir"
rm -rf "$run_dir/git.pristine" || kit_die 4 'could not remove saved git directory'
[ ! -e "$run_dir/git.pristine" ] || kit_die 4 'saved git directory remains'

# secret_scan's filename-based rules (.env*, *.pem, id_rsa*, ...) key off
# the brief's own name. Renaming it to a fixed "brief.md" snapshot would
# silently bypass those, so check the original path first -- before it's
# copied anywhere.
if ! secret_scan --credentials-only "$BRIEF" >"$run_dir/secret-scan-brief-name.txt" 2>&1; then
  cat "$run_dir/secret-scan-brief-name.txt" >&2
  kit_die 5 "secret scan found a possible secret in the brief; refusing to send to codex ($run_dir/secret-scan-brief-name.txt)"
fi

# Snapshot the brief into the run dir, then scan and send that exact
# snapshot. Scanning the original file and later re-reading it for `codex
# exec` would leave a gap for another process to swap in secret-bearing
# content in between.
brief_snapshot="$run_dir/brief.md"
cp "$BRIEF" "$brief_snapshot" || kit_die 2 "could not snapshot the brief into $run_dir"

# The exported tree and the brief snapshot are about to go to a third
# party (Codex). Refuse rather than leak a secret that happens to be
# checked into the repo or pasted into the brief.
if ! secret_scan --credentials-only "$wt" "$brief_snapshot" >"$run_dir/secret-scan.txt" 2>&1; then
  cat "$run_dir/secret-scan.txt" >&2
  kit_die 5 "secret scan found a possible secret; refusing to send to codex ($run_dir/secret-scan.txt)"
fi

# Codex runs without a sandbox or approval prompts for unattended builds.
#
# codex runs in the background under its own process group (set -m, like
# locked-build), and we `wait` for it: a signal to this script then reaches
# on_exit while codex is still running, which can kill the whole group before
# it deletes wt. The exit status, the output file and stdin are exactly what
# the old foreground call gave.
if command -v caffeinate >/dev/null 2>&1; then
  caffeinate -is -w $$ >/dev/null 2>&1 &
fi
run_agent_started "$run_dir" || kit_die 4 'could not mark the run as started'
# direct_codex ARGS...: one codex call in its own process group; appends to codex-output.txt, sets
# codex_code. The first call reads the brief on stdin; a continue passes its message as an argument.
direct_codex() {
  set -m
  if [ "$1" = exec ] && [ "${2:-}" != resume ]; then
    KIT_ROLE=worker codex "$@" < "$brief_snapshot" >> "$run_dir/codex-output.txt" 2>&1 &
  else
    ( cd "$wt" && KIT_ROLE=worker exec codex "$@" < /dev/null >> "$run_dir/codex-output.txt" 2>&1 ) &
  fi
  codex_pid=$!
  wait "$codex_pid"
  codex_code=$?
  # codex has exited; anything it left running in its group goes too, before
  # the diff below is taken.
  {
    kill -TERM -"$codex_pid" 2>/dev/null
    sleep 0.3
    kill -KILL -"$codex_pid" 2>/dev/null
  } 2>/dev/null
  codex_pid=""
  set +m
}
: > "$run_dir/codex-output.txt"
direct_codex exec -m "$MODEL" --dangerously-bypass-approvals-and-sandbox -C "$wt" -o "$run_dir/final-message.txt"
# An agent that ends its turn with the work clearly unfinished gets a "continue" (see
# lib/codex_continue.py), up to KIT_CODEX_CONTINUES times. Only a clean end is continued.
continues=0
while [ "$codex_code" -eq 0 ] && continue_why=$(codex_continue_check "$brief_snapshot" "$run_dir/final-message.txt"); do
  if [ "$continues" -ge "$KIT_CODEX_CONTINUES_N" ]; then
    echo "(stopped early after $continues continues: $continue_why)" >> "$run_dir/codex-output.txt"
    break
  fi
  session_id=$(sed -n 's/^session id: //p' "$run_dir/codex-output.txt" | head -1)
  if [ -z "$session_id" ]; then
    echo "(stopped early after $continues continues: $continue_why; no session id to continue)" >> "$run_dir/codex-output.txt"
    break
  fi
  continues=$((continues + 1))
  rm -f "$run_dir/final-message.txt"
  echo "(continue $continues: the agent stopped early: $continue_why)" >> "$run_dir/codex-output.txt"
  direct_codex exec resume "$session_id" -m "$MODEL" --dangerously-bypass-approvals-and-sandbox \
    -o "$run_dir/final-message.txt" "$(codex_continue_message)"
done

if [ "$codex_code" -ne 0 ]; then
  cat "$run_dir/codex-output.txt" >&2
  # codex may have edited files before it failed. wt leaves the run dir when the run
  # ends, so keep those edits as a patch, best effort, with the same git
  # safeguards as the success path below.
  salvage=""
  if run_build_patch_fresh "$wt" "$REPO" "$BASE" 2>/dev/null && [ -s "$run_dir/build.patch" ]; then
    salvage="; its partial edits are in $run_dir/build.patch"
  else
    rm -f "$run_dir/build.patch"
  fi
  if grep -Eiq 'not logged in|please log in|authentication required|unauthorized|run codex login' "$run_dir/codex-output.txt"; then
    kit_die 3 "Codex is not logged in; run codex login$salvage"
  fi
  kit_die 4 "codex exec failed; see $run_dir/codex-output.txt$salvage"
fi

# Stage with a fresh isolated clone after the provider process group has stopped.
run_build_patch_fresh "$wt" "$REPO" "$BASE" || exit 4
cat "$run_dir/build.patch"
echo "kit-codex-build: run dir: $run_dir"
if [ -s "$run_dir/build.patch" ]; then
  echo "next: git apply --index $run_dir/build.patch, run the checks, have the diff reviewed, commit"
else
  echo "next: no changes were made; read $run_dir/result.md"
fi
echo "kit-codex-build: build patch: $run_dir/build.patch"
# The last line (exit=0 patch=... result=...) is printed by the exit trap, like on every other exit.
