#!/usr/bin/env python3
"""kit-models-validate FILE [--guide GUIDE_JSON] -- check rules/models.json.

Exit 0 when the file is sound, 1 with one line on stderr per first problem,
2 on usage. Checks: allowed keys only; model ids match the id pattern; effort
values are in the enum; every fallback target exists and the fallback graph
has no cycle; every lane keeps its required roles (strong, build, lookup);
every routed model is offered by its CLI when kit-models-available knows that
list (exit 4 there = unknown = skipped). Reads only; never changes a cache.
Python 3.9 stdlib only.
"""
import json
import os
import re
import subprocess
import sys

ID = re.compile(r'^[a-z0-9][a-z0-9.-]{2,60}$')
DATE = re.compile(r'^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
ROLES = {'top', 'strong', 'review', 'build', 'lookup', 'mid', 'research', 'screens', 'long_read'}
LANE_KEYS = {'base_url', 'host'}
LANES = {'claude', 'codex', 'gemini', 'kimi', 'glm'}
AVAILABLE_LANES = ('claude', 'codex', 'gemini')
EFFORT = {'low', 'medium', 'high', 'xhigh', 'max'}
EFFORT_KEYS = {'use', 'min', 'max'}
TOP_KEYS = LANES | {'version', 'checked', 'pricing', 'pricing_checked', 'fallbacks', 'effort'}
HERE = os.path.dirname(os.path.abspath(__file__))


def guide_ids(path):
    if not path or not os.path.isfile(path):
        return set()
    try:
        with open(path, encoding='utf-8') as stream:
            rows = json.load(stream).get('models', [])
        return {row['id'] for row in rows if isinstance(row, dict) and isinstance(row.get('id'), str)}
    except (ValueError, OSError, AttributeError, KeyError):
        return set()


def offered(lane):
    """Model ids the lane's CLI offers, or None when that list is unknown."""
    tool = os.path.join(HERE, 'kit-models-available')
    if not os.path.isfile(tool):
        return None
    try:
        done = subprocess.run([tool, lane], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=30, universal_newlines=True)
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    ids = {line.strip() for line in done.stdout.splitlines() if line.strip()}
    return ids or None


def validate(data, guide=(), availability=True):
    if not isinstance(data, dict):
        raise ValueError('table must be an object')
    if set(data) - TOP_KEYS:
        raise ValueError('unknown table key: ' + ', '.join(sorted(set(data) - TOP_KEYS)))
    if 'checked' in data and not (isinstance(data['checked'], str) and DATE.match(data['checked'])):
        raise ValueError('checked must be a YYYY-MM-DD date')
    routed = {}
    for family in sorted(LANES & set(data)):
        lane = data[family]
        if not isinstance(lane, dict) or set(lane) - ROLES - LANE_KEYS:
            raise ValueError('invalid lane: ' + family)
        required = {'build'} if family in {'kimi', 'glm'} else {'strong', 'build', 'lookup'}
        missing = required - set(lane)
        if missing:
            raise ValueError('lane %s lost role: %s' % (family, ', '.join(sorted(missing))))
        for role in ROLES & set(lane):
            model = lane[role]
            if not isinstance(model, str) or not ID.fullmatch(model):
                raise ValueError('invalid model id in %s.%s' % (family, role))
            routed.setdefault(family, set()).add(model)
    models = set().union(*routed.values()) if routed else set()
    efforts = data.get('effort', {})
    if not isinstance(efforts, dict):
        raise ValueError('effort must be an object')
    for model, value in efforts.items():
        if not ID.fullmatch(model):
            raise ValueError('invalid model id in effort')
        values = [value]
        if isinstance(value, dict):
            if set(value) - EFFORT_KEYS:
                raise ValueError('invalid effort key for ' + model)
            values = list(value.values())
        if any(not isinstance(v, str) or v not in EFFORT for v in values):
            raise ValueError('invalid effort value for ' + model)
    fallbacks = data.get('fallbacks', {})
    if not isinstance(fallbacks, dict):
        raise ValueError('fallbacks must be an object')
    pricing = data.get('pricing', {})
    known = models | set(pricing if isinstance(pricing, dict) else {}) | set(efforts) | set(fallbacks)
    guide = set(guide)

    def exists(model):
        if model in known:
            return True
        return any(model == g or model.startswith(g + '-') for g in guide)

    for origin, target in fallbacks.items():
        if not isinstance(target, str) or not ID.fullmatch(origin) or not ID.fullmatch(target):
            raise ValueError('invalid model id in fallbacks')
        if not exists(target):
            raise ValueError('unknown fallback model: ' + target)
        seen = {origin}
        while target in fallbacks:
            if target in seen:
                raise ValueError('fallback cycle at ' + target)
            seen.add(target)
            target = fallbacks[target]
    if availability:
        for lane in AVAILABLE_LANES:
            if lane not in routed:
                continue
            ids = offered(lane)
            if ids is None:
                continue
            absent = sorted(routed[lane] - ids)
            if absent:
                raise ValueError('not offered by the %s CLI: %s' % (lane, ', '.join(absent)))


def main(argv):
    guide_path = os.path.join(HERE, '..', 'guide', 'guide.json')
    args = argv[1:]
    if len(args) == 3 and args[1] == '--guide':
        args, guide_path = [args[0]], args[2]
    if len(args) != 1:
        print('usage: kit-models-validate FILE [--guide GUIDE_JSON]', file=sys.stderr)
        return 2
    try:
        with open(args[0], encoding='utf-8') as stream:
            data = json.load(stream)
        validate(data, guide_ids(guide_path))
    except (ValueError, OSError, TypeError) as error:
        print(str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
