#!/bin/bash
# kit-common — sourced helpers for every routing-kit script.
# bash 3.2 compatible: no mapfile, no ${x,,}, no associative arrays.

kit_require_macos() {
  case "$(uname)" in
    Darwin) ;;
    *)
      echo "routing-kit is macOS-only" >&2
      exit 2
      ;;
  esac
}

# kit_require_supported — the non-jail gate: macOS, Linux, or WSL2 on
# Windows (which reports its uname as Linux). Native Windows (MINGW/MSYS/
# CYGWIN uname, e.g. git-bash) and anything else is refused.
kit_require_supported() {
  case "$(uname)" in
    Darwin|Linux) ;;
    *)
      echo "routing-kit needs macOS, Linux, or WSL2 on Windows" >&2
      exit 2
      ;;
  esac
}

# kit_require_kimi_glm_macos — Kimi and GLM (locked-build's Seatbelt jail)
# only ever run on a real Mac, even though the rest of the kit now runs on
# Linux/WSL2 too. A distinct message from kit_require_macos's, since a
# friend on Linux needs to know this is about Kimi/GLM specifically, not
# that the whole kit is unavailable to them.
kit_require_kimi_glm_macos() {
  case "$(uname)" in
    Darwin) ;;
    *)
      echo "Kimi and GLM need a Mac: they only run inside the macOS sandbox" >&2
      exit 2
      ;;
  esac
}

# kit_resolve_tools — picks the jq/python3 binaries kit_jq/kit_python3 use.
# Stock macOS keeps /usr/bin/jq and /usr/bin/python3 (the global brief's
# assumed baseline); anywhere else (Linux, WSL2) resolves via PATH instead,
# since those stock paths don't exist there. Run once, at source time, so
# every caller shares the same resolution without re-running `command -v`
# per call.
KIT_JQ_BIN=""
KIT_PYTHON3_BIN=""
kit_resolve_tools() {
  # KIT_TEST_NO_JQ / KIT_TEST_NO_PYTHON3: test-only overrides that force
  # "not found", the same way KIT_KEYCHAIN_CMD etc. let tests fake other
  # parts of this kit -- this dev Mac, like stock macOS, always has
  # /usr/bin/jq and /usr/bin/python3, so a test proving the public
  # commands' missing-dependency behavior (exit 3, install hint) can't
  # rely on either one actually being absent.
  if [ -n "${KIT_TEST_NO_JQ:-}" ]; then
    KIT_JQ_BIN=""
  elif [ -x /usr/bin/jq ]; then
    KIT_JQ_BIN=/usr/bin/jq
  else
    KIT_JQ_BIN="$(command -v jq 2>/dev/null || true)"
  fi
  if [ -n "${KIT_TEST_NO_PYTHON3:-}" ]; then
    KIT_PYTHON3_BIN=""
  elif [ -x /usr/bin/python3 ]; then
    KIT_PYTHON3_BIN=/usr/bin/python3
  else
    KIT_PYTHON3_BIN="$(command -v python3 2>/dev/null || true)"
  fi
}
kit_resolve_tools

# kit_require_jq / kit_require_python3 — exit 3 with an install hint right
# now, in the CALLER'S OWN SHELL, if kit_resolve_tools couldn't find the
# tool (only possible off macOS: kit_resolve_tools always finds macOS's
# stock /usr/bin/jq and /usr/bin/python3). A script that depends on jq/
# python3 to do anything useful should call these directly, as their own
# statement, before any `x=$(kit_jq ...)` command substitution that
# depends on the tool: kit_die's `exit` inside a `$(...)` subshell only
# ends that subshell, so a caller that then does
# `x=$(kit_jq ...) || kit_die 2 "some other, wrong reason"` would see its
# own generic fallback instead of jq's real exit 3 and install hint --
# the failure gets reported as the wrong problem, with the wrong exit code.
kit_require_jq() {
  [ -n "$KIT_JQ_BIN" ] || kit_die 3 "install jq (sudo apt install jq)"
}
kit_require_python3() {
  [ -n "$KIT_PYTHON3_BIN" ] || kit_die 3 "install python3 (sudo apt install python3)"
}

# kit_jq ARGS... — jq, wherever it was resolved to. Exit 3 with an install
# hint if this system has none. Safe to call directly; inside a `$(...)`
# command substitution, prefer calling kit_require_jq first, as its own
# statement in the parent shell (see above).
kit_jq() {
  kit_require_jq
  "$KIT_JQ_BIN" "$@"
}

# kit_python3 ARGS... — same idea as kit_jq, for python3.
kit_python3() {
  kit_require_python3
  "$KIT_PYTHON3_BIN" "$@"
}

# kit_mtime FILE — FILE's mtime as epoch seconds, or empty on error. BSD
# stat (macOS) takes `-f '%m'`; GNU stat (Linux) takes `-c '%Y'`.
kit_mtime() {
  case "$(uname)" in
    Darwin) stat -f '%m' "$1" 2>/dev/null ;;
    *) stat -c '%Y' "$1" 2>/dev/null ;;
  esac
}

# kit_die CODE MSG — print MSG to stderr and exit CODE.
kit_die() {
  code="$1"; shift
  echo "$*" >&2
  exit "$code"
}

# kit_canary_verdict LOGFILE STATUS — validates lib/canaries.sh's own
# "CANARY SUMMARY pass=N fail=N env_fail=N" line against STATUS (the real
# exit status of the canaries_run call that produced LOGFILE -- locked-
# build's own $canary_code / $final_canary_code) and returns exactly one
# of three verdicts:
#
#   0 -- a single, strictly-formatted summary line, consistent with a
#        clean round (STATUS 0, fail=0, env_fail=0). Safe to proceed.
#   4 -- a single, strictly-formatted summary line, consistent with a
#        failed round (STATUS != 0) where fail=0 and env_fail>0 -- a
#        positive control or a probe's own listener setup that was still
#        broken after canaries.sh's own retry. An environment problem, not
#        evidence the jail leaked.
#   5 -- every other case: fail>0 (a real, deterministic Seatbelt leak,
#        always wins), zero or more than one line beginning with "CANARY
#        SUMMARY", a line that doesn't match canaries_run's own exact
#        "pass=<digits> fail=<digits> env_fail=<digits>" format, or fields
#        that contradict STATUS. A result that can't be read as
#        "definitely, unambiguously fine or only an environment problem"
#        defaults to the stricter refusal.
#
# Called on EVERY round, not only a failed one (security review, round 2):
# a STATUS of 0 with an unreadable, missing, or self-contradictory log
# must not be silently treated as success either -- it is validated the
# same way, just against the "nothing failed" shape instead of "something
# failed".
#
# The candidate-line match is `^CANARY SUMMARY` with NO trailing space
# requirement, specifically so a malformed line like
# "CANARY SUMMARYjunk ... fail=1 ..." is still counted as a candidate
# (security review, round 2: the prior match required a literal space
# after SUMMARY, which "SUMMARYjunk" lacks, so that line was silently
# excluded from the count -- a log containing that junk line PLUS one
# well-formed summary line then read back as "exactly one valid summary"
# and returned 4, when the presence of ANY other line starting with the
# same prefix means the log can't be trusted to contain only what
# canaries_run itself would have printed). Earlier still (first review
# round), the prior form's `.* fail=` pattern could also be fooled by
# "fail=0garbage" (digit-then-anything, not digits-only) and by a
# duplicated "fail=1 fail=0" field.
kit_canary_verdict() {
  local log status count line pass fail env_fail
  log="$1"; status="$2"

  count=$(grep -c '^CANARY SUMMARY' "$log" 2>/dev/null)
  if [ "$count" != "1" ]; then
    echo 5
    return
  fi

  line=$(grep '^CANARY SUMMARY' "$log")
  if ! printf '%s\n' "$line" | grep -Eq '^CANARY SUMMARY pass=[0-9]+ fail=[0-9]+ env_fail=[0-9]+$'; then
    echo 5
    return
  fi

  pass=$(printf '%s\n' "$line" | sed -n 's/^CANARY SUMMARY pass=\([0-9][0-9]*\) fail=\([0-9][0-9]*\) env_fail=\([0-9][0-9]*\)$/\1/p')
  fail=$(printf '%s\n' "$line" | sed -n 's/^CANARY SUMMARY pass=\([0-9][0-9]*\) fail=\([0-9][0-9]*\) env_fail=\([0-9][0-9]*\)$/\2/p')
  env_fail=$(printf '%s\n' "$line" | sed -n 's/^CANARY SUMMARY pass=\([0-9][0-9]*\) fail=\([0-9][0-9]*\) env_fail=\([0-9][0-9]*\)$/\3/p')
  if [ -z "$pass" ] || [ -z "$fail" ] || [ -z "$env_fail" ]; then
    echo 5
    return
  fi

  if [ "$status" -eq 0 ] 2>/dev/null; then
    # A clean exit must be backed by an all-zero summary -- anything else
    # (the round claims to have failed something, or the status/log
    # disagree) can't be treated as success.
    if [ "$fail" -eq 0 ] && [ "$env_fail" -eq 0 ]; then
      echo 0
    else
      echo 5
    fi
    return
  fi

  # STATUS is nonzero here. The summary claiming nothing failed at all
  # contradicts canaries_run's own return convention (nonzero iff fail>0
  # or env_fail>0) -- can't be trusted either way.
  if [ "$fail" -eq 0 ] && [ "$env_fail" -eq 0 ]; then
    echo 5
    return
  fi

  if [ "$fail" -eq 0 ] && [ "$env_fail" -gt 0 ]; then
    echo 4
  else
    echo 5
  fi
}

KIT_HOME="${ROUTING_KIT_HOME:-$HOME/.config/routing-kit}"

# Claude Code can keep its settings and plugins outside the default folder.
kit_claude_dir() {
  printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
}

# kit_close_extra_fds — closes every open file descriptor above stderr (2)
# in the CURRENT shell. bash 3.2 safe: no `compgen -f /dev/fd`, just a glob
# over /dev/fd/* (present on stock macOS) filtered to numeric names > 2.
# A leaked fd bypasses every Seatbelt file-read/file-write rule outright --
# Seatbelt checks opens, not fds a process already holds -- so this must
# run in the same shell that is about to `exec sandbox-exec ...`, not in a
# child of it (closing fds in a child closes only the child's copies).
# Looping only over a fixed list like "3 4 5 6 7 8 9" (the previous
# canaries.sh behavior) misses anything opened at a higher number, e.g. by
# a caller further up the call chain.
kit_close_extra_fds() {
  local fdpath fd
  for fdpath in /dev/fd/*; do
    fd="${fdpath##*/}"
    case "$fd" in
      0|1|2) continue ;;
      *[!0-9]*) continue ;;
    esac
    eval "exec $fd>&-" 2>/dev/null
  done
}

# kit_realpath DIR — resolved absolute path (cd "$p" && pwd -P).
kit_realpath() {
  ( cd "$1" 2>/dev/null && pwd -P )
}

# kit_key PROVIDER — read the provider's key from the Keychain.
# service name: routing-kit-<provider>. Exit 3 with a plain message when
# missing. Overridable by KIT_KEYCHAIN_CMD for tests.
kit_key() {
  local provider service out code
  provider="$1"
  service="routing-kit-$provider"
  if [ -n "${KIT_KEYCHAIN_CMD:-}" ]; then
    out=$($KIT_KEYCHAIN_CMD -s "$service" -w 2>/dev/null)
    code=$?
  else
    out=$(security find-generic-password -s "$service" -w 2>/dev/null)
    code=$?
  fi
  if [ $code -ne 0 ] || [ -z "$out" ]; then
    kit_die 3 "no key for $provider: run security add-generic-password -s $service -a \"\$USER\" -w"
  fi
  echo "$out"
}

# kit_git ARGS... — git with host config, hooks AND the caller's environment
# isolated: no system or global gitconfig, no hooks, no fsmonitor, and no
# inherited environment at all beyond a minimal PATH and a throwaway HOME.
# Used for every git call this kit makes against a jailed working tree or a
# repo it clones, so a `.git/config` or `.gitattributes` a jailed build
# could write (core.fsmonitor, a clean/smudge filter, a diff textconv)
# never gets to execute anything outside the jail when the kit itself later
# runs `git status`/`add`/`diff` on that tree.
#
# `env GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git ...` (the prior
# form) only ever set two variables on top of the caller's full inherited
# environment -- it never cleared anything. Any `GIT_CONFIG_COUNT` /
# `GIT_CONFIG_KEY_*` / `GIT_CONFIG_VALUE_*` / `GIT_CONFIG_PARAMETERS`
# already in the environment (e.g. a smudge/clean filter set that way,
# confirmed to survive clone and the post-run add/diff) still reached git
# untouched, and so did `GIT_DIR` / `GIT_WORK_TREE` / `GIT_EXEC_PATH` /
# `GIT_ATTR_SOURCE`. `env -i` with only what git needs closes all of those
# at once. HOME is a throwaway per-call directory (never the real $HOME,
# never a jailed run's $run_home) so git has nowhere to find a stray
# ~/.gitconfig either, even though GIT_CONFIG_GLOBAL=/dev/null already
# covers that path specifically. Removed again once this one git command
# returns -- a prior form cached one such directory for the whole process
# (created once, reused, never removed), which meant every process that
# ever called kit_git (every test run, every locked-build run) left one
# more kit-git-home.* directory under $TMPDIR behind forever.
kit_git() {
  local git_home git_code
  git_home="$(mktemp -d "${TMPDIR:-/tmp}/kit-git-home.XXXXXX")" \
    || kit_die 2 "could not create a throwaway HOME for git"
  env -i \
    PATH=/usr/bin:/bin \
    HOME="$git_home" \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_CONFIG_GLOBAL=/dev/null \
    git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
  git_code=$?
  rm -rf "$git_home"
  return "$git_code"
}
