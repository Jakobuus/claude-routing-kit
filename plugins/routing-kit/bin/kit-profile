#!/bin/bash
# kit-profile — read/write/validate $KIT_HOME/profile.json.
# Usage: kit-profile get | kit-profile set KEY VALUE | kit-profile validate
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
. "$SCRIPT_DIR/kit-common"
kit_require_supported
# jq is essential here: fail fast (exit 3, install hint) rather than
# letting a `x=$(kit_jq ...)` below mask the real problem.
kit_require_jq

PROFILE_PATH="$KIT_HOME/profile.json"

DEFAULT_PROFILE='{"version":1,"codex":"none","gemini":"none","jules":false,"kimi":false,"glm":false,"paseo":false}'

cmd_get() {
  if [ ! -f "$PROFILE_PATH" ]; then
    kit_die 3 "no profile yet: run START-HERE.md"
  fi
  cat "$PROFILE_PATH"
}

valid_value() {
  key="$1"; value="$2"
  case "$key" in
    owner_name) return 0 ;;
    kit_rules) case "$value" in append|replace) return 0 ;; *) return 1 ;; esac ;;
    claude_plan) case "$value" in none|pro|max5|max20|team|api) return 0 ;; *) return 1 ;; esac ;;
    main_agent) case "$value" in claude|codex|gemini) return 0 ;; *) return 1 ;; esac ;;
    gemini) case "$value" in none|pro|ultra) return 0 ;; *) return 1 ;; esac ;;
    codex) case "$value" in none|plus|pro|business|api) return 0 ;; *) return 1 ;; esac ;;
    jules|kimi|glm|paseo) case "$value" in true|false) return 0 ;; *) return 1 ;; esac ;;
    owner_checkouts|protected_paths) printf '%s' "$value" | kit_jq -e 'type == "array" and all(.[]; type == "string")' >/dev/null 2>&1; return $? ;;
    blocks) printf '%s' "$value" | kit_jq -e 'type == "boolean" or (type == "object" and all(to_entries[]; if .key == "destructive" or .key == "owner_checkout" then (.value | type == "boolean") else true end))' >/dev/null 2>&1; return $? ;;
    version) case "$value" in 1) return 0 ;; *) return 1 ;; esac ;;
    jules_daily_limit) case "$value" in ''|*[!0-9]*|0) return 1 ;; *) return 0 ;; esac ;;
    *) return 1 ;;
  esac
}

cmd_set() {
  key="$1"; value="$2"
  if [ -z "${key:-}" ] || { [ -z "${value:-}" ] && [ "$key" != owner_name ]; }; then
    kit_die 2 "usage: kit-profile set KEY VALUE"
  fi
  if ! valid_value "$key" "$value"; then
    kit_die 2 "invalid value for $key: value not allowed"
  fi
  case "$key" in
    kimi|glm)
      if [ "$value" = true ] && [ "$(uname)" != Darwin ]; then
        kit_die 2 "Kimi and GLM need a Mac: they only run inside the macOS sandbox"
      fi
      ;;
  esac
  if [ -f "$PROFILE_PATH" ]; then
    base=$(cat "$PROFILE_PATH")
  else
    base="$DEFAULT_PROFILE"
  fi
  # The main agent needs its own lane, and a user without a Claude plan needs a
  # main agent that is not Claude. Refuse a change that would break either, with
  # one line, before anything is written.
  cur_main=$(echo "$base" | kit_jq -r '.main_agent // "claude"')
  cur_codex=$(echo "$base" | kit_jq -r '.codex // "none"')
  cur_gemini=$(echo "$base" | kit_jq -r '.gemini // "none"')
  cur_plan=$(echo "$base" | kit_jq -r '.claude_plan // ""')
  case "$key" in
    main_agent)
      case "$value" in
        codex) [ "$cur_codex" != none ] || kit_die 2 "main_agent codex needs a Codex plan: run kit-profile set codex <plan> first" ;;
        gemini) [ "$cur_gemini" != none ] || kit_die 2 "main_agent gemini needs a Gemini plan: run kit-profile set gemini <plan> first" ;;
        claude) [ "$cur_plan" != none ] || kit_die 2 "main_agent claude needs a Claude plan: run kit-profile set claude_plan <plan> first" ;;
      esac ;;
    codex)
      if [ "$value" = none ] && [ "$cur_main" = codex ]; then
        kit_die 2 "Codex is your main agent: run kit-profile set main_agent <other> before turning it off"
      fi ;;
    gemini)
      if [ "$value" = none ] && [ "$cur_main" = gemini ]; then
        kit_die 2 "Gemini is your main agent: run kit-profile set main_agent <other> before turning it off"
      fi ;;
    claude_plan)
      if [ "$value" = none ] && [ "$cur_main" = claude ]; then
        kit_die 2 "claude_plan none needs a main agent other than Claude: run kit-profile set main_agent codex|gemini first"
      fi ;;
  esac
  mkdir -p "$KIT_HOME"
  tmp="$KIT_HOME/profile.json.tmp.$$"
  case "$key" in
    blocks|owner_checkouts|protected_paths|jules|kimi|glm|paseo|version|jules_daily_limit)
      echo "$base" | kit_jq --arg k "$key" --argjson v "$value" '.[$k] = $v' > "$tmp" || { rm -f "$tmp"; kit_die 2 "could not write profile"; }
      ;;
    *)
      echo "$base" | kit_jq --arg k "$key" --arg v "$value" '.[$k] = $v' > "$tmp" || { rm -f "$tmp"; kit_die 2 "could not write profile"; }
      ;;
  esac
  mv "$tmp" "$PROFILE_PATH" || { rm -f "$tmp"; kit_die 2 "could not save profile"; }
}

cmd_validate() {
  if [ ! -f "$PROFILE_PATH" ]; then
    exit 2
  fi
  kit_jq -e '
    (.version == 1) and
    ((has("blocks") | not) or (.blocks | type == "boolean" or (type == "object" and all(to_entries[]; if .key == "destructive" or .key == "owner_checkout" then (.value | type == "boolean") else true end)))) and
    ((has("owner_name") | not) or (.owner_name | type == "string")) and
    ((has("kit_rules") | not) or (.kit_rules == "append" or .kit_rules == "replace")) and
    ((.main_agent // "claude") as $m | (["claude","codex","gemini"] | index($m) != null)) and
    ((.claude_plan // "") as $c | (.main_agent // "claude") as $m |
      (["pro","max5","max20","team","api"] | index($c) != null) or ($c == "none" and $m != "claude")) and
    ((if .codex == null then "none" else .codex end) as $c |
      ($c | type) == "string" and (["none","plus","pro","business","api"] | index($c) != null)) and
    ((if .gemini == null then "none" else .gemini end) as $g |
      ($g | type) == "string" and (["none","pro","ultra"] | index($g) != null)) and
    ((.main_agent // "claude") as $m |
      ($m == "claude") or
      ($m == "codex" and (.codex // "none") != "none") or
      ($m == "gemini" and (.gemini // "none") != "none")) and
    ((.jules // false) == true or (.jules // false) == false) and
    ((.kimi // false) == true or (.kimi // false) == false) and
    ((.glm // false) == true or (.glm // false) == false) and
    ((.paseo // false) == true or (.paseo // false) == false) and
    ((.jules_daily_limit // 15) as $j | ($j | type) == "number" and ($j == ($j | floor)) and $j > 0) and
    ((has("products") | not) or
      (.products | type == "array" and all(.[]; type == "string"))) and
    ((if .skills == null then [] else .skills end) as $s |
      ($s | type) == "array" and ([$s[] | (type == "string")] | all))
  ' "$PROFILE_PATH" >/dev/null 2>&1
  code=$?
  if [ "$code" -ne 0 ]; then
    exit 2
  fi
  exit 0
}

case "${1:-}" in
  get) cmd_get ;;
  set) shift; cmd_set "${1:-}" "${2:-}" ;;
  validate) cmd_validate ;;
  *) kit_die 2 "usage: kit-profile get|set KEY VALUE|validate" ;;
esac
